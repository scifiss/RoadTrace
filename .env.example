# Optional semantic refinement. Both values are required to enable it.
OPENAI_API_KEY=
OPENAI_MODEL=

# Local persistence and browser origin.
ROADTRACE_DATABASE_PATH=roadtrace.sqlite3
ROADTRACE_CORS_ORIGINS=http://localhost:5173

# Untrusted-repository safety budgets.
ROADTRACE_MAX_FILES=3000
ROADTRACE_MAX_COMMITS=500
ROADTRACE_CLONE_DEPTH=5000
ROADTRACE_MAX_FILE_BYTES=1000000
ROADTRACE_MAX_SOURCE_BYTES=30000000
ROADTRACE_MAX_REPOSITORY_BYTES=300000000
ROADTRACE_MAX_GRAPH_NODES=180
ROADTRACE_MAX_WORKFLOW_DEPTH=4
ROADTRACE_CLONE_TIMEOUT_SECONDS=120
ROADTRACE_GIT_TIMEOUT_SECONDS=30
